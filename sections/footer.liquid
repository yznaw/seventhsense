{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank
    assign has_social_icons = true
  elsif settings.social_instagram_link != blank
    assign has_social_icons = true
  elsif settings.social_youtube_link != blank
    assign has_social_icons = true
  elsif settings.social_tiktok_link != blank
    assign has_social_icons = true
  elsif settings.social_twitter_link != blank
    assign has_social_icons = true
  elsif settings.social_pinterest_link != blank
    assign has_social_icons = true
  elsif settings.social_snapchat_link != blank
    assign has_social_icons = true
  elsif settings.social_tumblr_link != blank
    assign has_social_icons = true
  elsif settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif

  assign brand_title = settings.brand_headline | strip_html
  if brand_title == blank
    assign brand_title = shop.name
  endif

  assign brand_copy = settings.brand_description
  assign brand_copy_text = brand_copy | strip_html | strip
  if brand_copy_text == blank and section.settings.footer_intro != blank
    assign brand_copy = section.settings.footer_intro
  endif
-%}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer ss-footer color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ss-footer__top">
      <div class="ss-footer__brand" data-ss-reveal>
        <a href="{{ routes.root_url }}" class="ss-brand-lockup">
          {%- if settings.logo != blank -%}
            <span class="ss-brand-lockup__logo">
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
              {{
                settings.logo
                | image_url: width: 320
                | image_tag:
                  widths: '80, 120, 160, 220, 320',
                  width: settings.logo_width,
                  height: logo_height,
                  alt: logo_alt,
                  loading: 'lazy'
              }}
            </span>
          {%- endif -%}
          <span class="ss-brand-lockup__name">{{ brand_title }}</span>
        </a>

        <h2 class="ss-footer__brand-title">
          <a href="{{ routes.root_url }}">{{ brand_title }}</a>
        </h2>

        {%- if brand_copy != blank -%}
          <div class="ss-footer__brand-copy rte">
            {{ brand_copy }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="ss-footer__menus" data-ss-reveal style="--ss-delay: 0.08s;">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'link_list' -%}
                  {%- if block.settings.menu != blank -%}
                    <h3 class="ss-footer__menu-title">{{ block.settings.heading | escape }}</h3>
                    <ul class="ss-footer__menu-list">
                      {%- for link in block.settings.menu.links -%}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h3 class="ss-footer__menu-title">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtext != blank -%}
                    <div class="ss-footer__text rte">{{ block.settings.subtext }}</div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.newsletter_enable -%}
        <div class="ss-footer__newsletter" data-ss-reveal style="--ss-delay: 0.16s;">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="ss-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="ss-footer__newsletter-copy rte">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}

          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="{{ 'newsletter.label' | t }}"
                  required
                >
                <label class="field__label" for="NewsletterForm--{{ section.id }}">
                  {{ 'newsletter.label' | t }}
                </label>
                <button
                  type="submit"
                  class="newsletter-form__button field__button"
                  name="commit"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>

              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>

            {%- if form.posted_successfully? -%}
              <h3
                class="newsletter-form__message newsletter-form__message--success form__message"
                id="ContactFooter-success"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ss-footer__bottom" data-ss-reveal>
      {%- if section.settings.show_social and has_social_icons -%}
        {%- render 'social-icons', class: 'ss-footer__social' -%}
      {%- endif -%}

      <div class="ss-footer__meta">
        <p class="ss-footer__copy">
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
        </p>

        {%- if section.settings.show_policy -%}
          <ul class="ss-footer__legal">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Navigation"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Text",
          "default": "<p>Use this space for a concise brand note or supporting message.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "richtext",
      "id": "footer_intro",
      "label": "Footer intro",
      "default": "<p>Quiet luxury skincare with a clean point of view, formulated for rituals that feel effortless.</p>"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our email list"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "<p>Receive new launches, routines, and thoughtful updates.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ]
}
{% endschema %}
