{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_alt = hero_image.alt
  if hero_alt == blank
    assign hero_alt = section.settings.heading | strip_html
  endif

  assign cta_link = section.settings.cta_link | default: '#ss-featured-products'
  assign hero_video = section.settings.hero_video
  assign navigation_menu = section.settings.navigation_menu
  assign floating_brand_label = section.settings.brand_name | default: shop.name
  assign theme_logo = blank
  if section.settings.show_theme_logo
    assign theme_logo = settings.logo
    if theme_logo == blank and shop.brand.logo != blank
      assign theme_logo = shop.brand.logo
    endif
  endif

-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 0;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="ss-section ss-shell ss-hero-section section-{{ section.id }}-padding">
  <div class="page-width">
    <a href="{{ routes.root_url }}" class="ss-floating-logo" aria-label="{{ floating_brand_label | escape }}">
      {%- if section.settings.floating_logo != blank -%}
        {{
          section.settings.floating_logo
          | image_url: width: 360
          | image_tag:
            widths: '120, 180, 240, 300, 360',
            width: 240,
            alt: floating_brand_label,
            loading: 'eager'
        }}
      {%- elsif theme_logo != blank -%}
        {%- assign floating_logo_alt = theme_logo.alt | default: floating_brand_label | escape -%}
        {%- assign floating_logo_aspect_ratio = theme_logo.aspect_ratio | default: 1 -%}
        {%- assign floating_logo_height = 240 | divided_by: floating_logo_aspect_ratio -%}
        {{
          theme_logo
          | image_url: width: 360
          | image_tag:
            widths: '120, 180, 240, 300, 360',
            width: 240,
            height: floating_logo_height,
            alt: floating_logo_alt,
            loading: 'eager'
        }}
      {%- elsif section.settings.logo_image_url != blank -%}
        <img
          src="{{ section.settings.logo_image_url | escape }}"
          alt="{{ floating_brand_label | escape }}"
          width="240"
          height="120"
          loading="eager"
        >
      {%- else -%}
        <span>{{ floating_brand_label | escape }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.show_language_toggle and localization.available_languages.size > 1 -%}
      {%- liquid
        assign ss_toggle_locale_code = ''
        assign ss_toggle_locale_label = ''

        for language in localization.available_languages
          assign language_code = language.iso_code | slice: 0, 2 | upcase

          if language.iso_code != localization.language.iso_code
            if language_code == 'AR' or language_code == 'EN'
              assign ss_toggle_locale_code = language.iso_code
              assign ss_toggle_locale_label = language_code
              break
            endif
          endif
        endfor
      -%}
      {%- form 'localization', id: 'SeventhsenseLanguageForm', class: 'ss-language-toggle' -%}
        <span class="visually-hidden">{{ 'localization.language_label' | t }}</span>
        {%- if ss_toggle_locale_code != blank -%}
          <button
            type="submit"
            name="locale_code"
            value="{{ ss_toggle_locale_code }}"
            class="ss-language-toggle__button is-active"
            lang="{{ ss_toggle_locale_code }}"
          >
            {{ ss_toggle_locale_label }}
          </button>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="ss-floating-cart" aria-label="{{ 'templates.cart.cart' | t }}">
      <span class="ss-floating-cart__icon" aria-hidden="true">
        {%- if cart == empty -%}
          {{ 'icon-cart-empty.svg' | inline_asset_content }}
        {%- else -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        {%- endif -%}
      </span>
      {%- if cart != empty -%}
        <span class="ss-floating-cart__count" aria-hidden="true">
          {%- if cart.item_count < 100 -%}
            {{ cart.item_count }}
          {%- else -%}
            99+
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>

    {%- if navigation_menu != blank -%}
      <nav class="ss-floating-tabs" aria-label="Primary navigation" data-ss-reveal>
        <ul class="ss-floating-tabs__list">
          {%- for link in navigation_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="ss-floating-tabs__link{% if link.current %} is-active{% endif %}">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="ss-hero">
      <div class="ss-hero__content" data-ss-reveal>
        <div class="ss-brand-lockup">
          <p class="ss-brand-lockup__name">{{ section.settings.brand_name | default: shop.name | escape }}</p>
        </div>

        {%- if section.settings.eyebrow != blank -%}
          <p class="ss-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="ss-hero__title">{{ section.settings.heading }}</h1>

        {%- if section.settings.description != blank -%}
          <div class="ss-hero__text rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        <div class="ss-hero__actions">
          <a class="ss-button ss-button--primary" href="{{ cta_link }}">
            {{ section.settings.cta_label | escape }}
          </a>
        </div>
      </div>

      <div class="ss-hero__media" data-ss-reveal style="--ss-delay: 0.12s;">
        <div class="ss-hero__media-frame">
          <div class="ss-hero__image-wrap" data-ss-parallax>
            {%- if hero_video != blank -%}
              {{
                hero_video
                | video_tag:
                  image_size: '1200x',
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true,
                  preload: 'metadata',
                  class: 'ss-hero__video'
              }}
            {%- elsif hero_image != blank -%}
              {{
                hero_image
                | image_url: width: 1440
                | image_tag:
                  class: 'ss-hero__image',
                  widths: '480, 720, 960, 1200, 1440',
                  sizes: '(min-width: 990px) 42vw, 82vw',
                  alt: hero_alt,
                  loading: 'eager'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ss-hero__image placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Seventhsense Hero",
  "settings": [
    {
      "type": "link_list",
      "id": "navigation_menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_language_toggle",
      "label": "Show AR / EN language toggle",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "floating_logo",
      "label": "Top-left logo image"
    },
    {
      "type": "text",
      "id": "logo_image_url",
      "label": "Fallback logo image URL"
    },
    {
      "type": "checkbox",
      "id": "show_theme_logo",
      "label": "Show theme logo",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Seventhsense"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium skincare"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Natural Self Care, Designed for Everyday Rituals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>There are moments when the world grows quieter and something within you begins to settle. The breath slows, the senses soften, and the body returns to its natural rhythm.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "product_note_label",
      "label": "Product note label",
      "default": "Signature cream"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Seventhsense Hero"
    }
  ]
}
{% endschema %}
